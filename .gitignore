# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
notebooks/__marimo__/

# Virtual environments
.venv
# R
renv/*
!renv/activate.R
!renv/settings.json
# STM exchange files between R and run_stm.py
.stm_tmp/

# Gemini
.gemini/
scratch/

# Research directories - keep structure but ignore content
data/*
!data/.gitkeep
!data/interim/
!data/processed/
!data/raw/
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/raw/*
!data/raw/.gitkeep

logs/*
!logs/.gitkeep

results/*
!results/.gitkeep

output/*
!output/.gitkeep

tables/*
!tables/.gitkeep

models/

.stignore
.stfolder
