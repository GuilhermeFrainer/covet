# Minimal R environment for training STM baselines on the cluster.
#
# The image holds only R and the packages scripts/r_scripts/train_stm.R needs.
# Code and data are mounted at run time and evaluation runs in Python outside
# the container (see scripts/experiments/run_stm.py), so no build context is
# needed:
#   docker build --platform linux/amd64 -t cast:stm-lite-v0.2.0 - < Dockerfile.stm
FROM rocker/r-ver:4.5.0

# A dated Posit Package Manager snapshot of prebuilt Ubuntu binaries, so
# nothing compiles. This date matches renv.lock (stm 1.3.8, data.table 1.18.4,
# quanteda 4.4), so the image fits the same packages as a local renv run.
ARG CRAN_SNAPSHOT=https://p3m.dev/cran/__linux__/noble/2026-05-14
RUN install2.r --error --skipinstalled --ncpus -1 -r ${CRAN_SNAPSHOT} stm optparse \
    && rm -rf /tmp/downloaded_packages /tmp/*.rds

WORKDIR /work

CMD ["Rscript", "-e", "library(stm); library(data.table); library(optparse); sessionInfo()"]
