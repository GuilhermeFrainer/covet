# Use rocker/r-ver for a stable Ubuntu-based R environment
FROM rocker/r-ver:4.4.1

# 1. Install system dependencies for R packages (stm, jsonlite, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    cmake \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# 2. Copy renv configuration files
# We copy these first to leverage Docker's layer caching
COPY renv.lock .Rprofile ./
COPY renv/activate.R renv/activate.R
COPY renv/settings.json renv/settings.json

# 3. Restore the R environment using renv
# This will install all packages listed in renv.lock
# NOTE: This step can take 15-30 minutes as it compiles packages from source
RUN R -e "install.packages('renv', repos='https://cloud.r-project.org')" \
    && R -e "renv::restore()"

# 4. Copy the script into the container
COPY scripts/r_scripts/stm_smoke_test.R /app/stm_smoke_test.R

# Define the command that runs when the container starts
CMD ["Rscript", "/app/stm_smoke_test.R"]
